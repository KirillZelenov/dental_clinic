<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.kafpin.dental_clinic.controller.ServicesController"
      style="-fx-background-color: white; -fx-padding: 15;">

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Поиск по названию услуги" HBox.hgrow="ALWAYS"/>
        <Button fx:id="searchButton" text="Найти"/>
        <Button fx:id="addButton" text="Добавить"/>
        <Button fx:id="editButton" text="Редактировать"/>
        <Button fx:id="deleteButton" text="Удалить"/>
        <Button fx:id="refreshButton" text="Обновить"/>
    </HBox>

    <TableView fx:id="servicesTable" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label text="Нет данных для отображения"/>
        </placeholder>
    </TableView>

</VBox>