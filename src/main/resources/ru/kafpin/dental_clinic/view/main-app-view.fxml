<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #ecf0f1;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.kafpin.dental_clinic.controller.MainController">

    <top>
        <VBox spacing="5" style="-fx-background-color: #2c3e50;">
            <MenuBar style="-fx-background-color: #2c3e50;">
                <Menu fx:id="fileMenu" text="Файл">
                    <MenuItem fx:id="exitMenuItem" text="Выход" onAction="#handleExit"/>
                </Menu>
                <Menu fx:id="referencesMenu" text="Справочники">
                    <MenuItem fx:id="doctorsMenuItem" text="Врачи" onAction="#openDoctors"/>
                    <MenuItem fx:id="servicesMenuItem" text="Услуги" onAction="#openServices"/>
                </Menu>
                <Menu fx:id="helpMenu" text="Справка">
                    <MenuItem fx:id="aboutMenuItem" text="О программе" onAction="#showAbout"/>
                </Menu>
                <Menu fx:id="languageMenu" text="Язык"/>
            </MenuBar>
        </VBox>
    </top>

    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" />
    </center>

    <bottom>
        <StackPane style="-fx-background-color: #34495e; -fx-padding: 5;">
            <Label fx:id="statusLabel" style="-fx-text-fill: white; -fx-font-size: 12px;" text="АРМ администратора стоматологической клиники" />
        </StackPane>
    </bottom>

</BorderPane>